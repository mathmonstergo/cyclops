DATABASE_URL=postgresql://cyclops:<db-password>@127.0.0.1:5432/cyclops
SETTINGS_FILE=data/settings.local.json
TENANT_ID=default
UPLOAD_DIR=data/uploads
MINERU_API_TOKEN=
MINERU_PARSE_TIMEOUT_SECONDS=600
MINERU_USE_KB_PACKAGER=true
IMPORT_PARSE_WORKER_POLL_INTERVAL_SECONDS=1
IMPORT_PARSE_WORKER_LEASE_SECONDS=60
KG_EXTRACTION_WORKER_POLL_SECONDS=0.5
KG_EXTRACTION_WORKER_LEASE_SECONDS=180

CHAT_BASE_URL=<openai-compatible-chat-base-url>
CHAT_API_KEY=<chat-api-key>
CHAT_MODEL=<chat-model-name>

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=<dashscope-api-key>
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

WECHAT_TOKEN_FILE=/home/adam/.wxbot/token.json
WECHAT_MESSAGE_CHUNK_SIZE=1800
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
